# client/.env.example — copy to client/.env.local for local dev
# Public URL of the FastAPI AI service (e.g. Cloudflare Tunnel). Leave empty to run AI in the browser only.
# Can also be set at runtime: https://<site>/?ai=https://xxxx.trycloudflare.com
VITE_AI_SERVICE_URL=http://localhost:8000

# Server-side only (Vercel Functions in client/api). Set these in Vercel > Project > Settings > Environment Variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

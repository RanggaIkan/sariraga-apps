# .gitignore
# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Python Virtual Environment & Cache
venv/
.venv/
env/
ai_service/venv/
ai_service/.venv/
__pycache__/
*.py[cod]
*$py.class

# Build & Distribution
dist/
build/
client/dist/

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
server/.env
client/.env

# AI Model Weights (Large binaries)
*.pt
*.onnx
*.weights
!ai_service/models/.gitkeep

# Logs & OS Metadata
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
.vscode/
.idea/

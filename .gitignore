# .gitignore
# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Python Virtual Environment & Cache
venv/
.venv/
env/
ai_service/venv/
ai_service/.venv/
__pycache__/
*.py[cod]
*$py.class

# Build & Distribution
dist/
build/
client/dist/

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
server/.env
client/.env

# AI Model Weights (Large binaries)
*.pt
*.onnx
*.weights
!ai_service/models/.gitkeep
# SariRaga YOLO11n model (10 MB) is committed so deploys work out of the box
!ai_service/models/sariraga_yolo11n.onnx
!client/public/models/sariraga_yolo11n.onnx

# Logs & OS Metadata
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
.vscode/
.idea/

# Vercel
.vercel

# onnxruntime-web runtime, copied from node_modules by scripts/copy-ort.mjs
client/public/ort/
